Patch "Supreme Address Edits"
//
	#lib "Memory"
//
{ 
	WriteProtected<byte> (/* 0x14145D190 */ ScanSignature ("ev5030", "xxxxxx"), System.Text.Encoding.UTF8.GetBytes("ev503X"));
	WriteProtected<byte> (/* 0x1414348B4 */ ScanSignature ("ev5040", "xxxxxx"), System.Text.Encoding.UTF8.GetBytes("ev504X"));
	WriteProtected<byte> (/* 0x14143739C */ ScanSignature ("ev6030", "xxxxxx"), System.Text.Encoding.UTF8.GetBytes("ev603X"));
	
	// Shot2 = zev_rfl_sp02
    if(ScanSignature("\xB0\xFD\x02\x03\x4C\x8B\xC0\x48\x8B\xCB\xE8\x3D\x84\xF9\xFF\x48\x8B\x4C\x24\x58\x48\x85\xC9\x74\x05\xE8\x9E\xDD", "xxxxxxxxxxxxxxxxxxxxxxxxxxxx") == 0) 
    { WriteProtected<byte> (0x14145E9C0, new byte[] { 0x00, 0x3E, 0x32, 0x40, 0x01 }); }
    else 
    { WriteProtected<byte> (0x14145E9F0, new byte[] { 0x00, 0x3E, 0x32, 0x40, 0x01 }); }

	// Shot4 = zev_rfl_sp01
	if(ScanSignature("\xB0\xFD\x02\x03\x4C\x8B\xC0\x48\x8B\xCB\xE8\x3D\x84\xF9\xFF\x48\x8B\x4C\x24\x58\x48\x85\xC9\x74\x05\xE8\x9E\xDD", "xxxxxxxxxxxxxxxxxxxxxxxxxxxx") == 0) 
    { WriteProtected<byte> (0x1403239BB, new byte[] { 0x48, 0x8D, 0x15, 0x3E, 0xE5, 0x13, 0x01 }); }
    else 
    { WriteProtected<byte> (0x1403239BB, new byte[] { 0x48, 0x8D, 0x15, 0x6E, 0xE5, 0x13, 0x01 }); }
} 

Code "Supreme Combat"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "INI"
	#lib "BossRifleConfig"
	#import "Services"
	
	static int BossHP = 0;
	static bool IsConfigInitialised = false;
//
{
	var BossRifleConfigInfo = Reflection.GetDataInfo<BossRifleConfig.Root>("boss_rifle");
	if (BossRifleConfigInfo.pData == null)
		return;
	
	if (!IsConfigInitialised)
    {
		var mod = HMM.GetModByID("566416");
		
		if (mod == null)
			return;
		
		string modConfigIniPath = System.IO.Path.Combine(mod.Path, "mod.ini");
		var ini = INI.Read(modConfigIniPath);
			
		BossHP = INI.Parse<int>(ini["Main"]["BossCombat"], BossHP);
        IsConfigInitialised = true;
		
		bool isChaosPolarity = HMM.GetMods().Where(x => x.Name == "Chaos Polarity").Count() > 0;
		bool isRifleBeast0 = (GameManager.GetGameObject("RifleBeast0") != null);
		if ((BossHP == 1) || (isChaosPolarity))
        { 
			if (!isRifleBeast0)
			{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 150000); }
			else
			{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 100000); }
		
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumQuickCyloopUp, 10);
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumQuickCyloopDown, 10);
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumSonicSpecial, 20);
		}
		else if (BossHP == 2)
        { 
			if (!isRifleBeast0)
			{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 267000); }
			else
			{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 225000); }
		
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumQuickCyloopUp, 5);
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumQuickCyloopDown, 5);
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumSonicSpecial, 10);
		}
        else
        { 
			if (!isRifleBeast0)
			{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 375000); }
			else
			{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 350000); }
		
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumQuickCyloopUp, 0);
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumQuickCyloopDown, 0);
			RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.dropRing.ringNumSonicSpecial, 0);
		}
	}
}

Code "Supreme moveset" by "Hypernova"
//
	#include "Reflection" noemit
	#lib "Reflection"
    #lib "HMM"
	#lib "Lua"
	#lib "GameMode"
	#lib "GameObject"
	#lib "BossRifleConfig"
	#import "Services"
	
	static long Adr4110 = 0;
	static long Adr4140 = 0;
	static long Adr4160 = 0;
	static bool IsConfigInitialised = false;
//
{
	if (Adr4110 == 0) { /* 0x1414624B0 */ Adr4110 = ScanSignature ("bo4110", "xxxxxx"); }
	if (Adr4160 == 0) { /* 0x1414624B8 */ Adr4160 = ScanSignature ("bo4160", "xxxxxx"); }
	
	var BossRifleConfigInfo = Reflection.GetDataInfo<BossRifleConfig.Root>("boss_rifle");
	if (BossRifleConfigInfo.pData == null)
		return;
	
	bool isRifleBeast0 = (GameManager.GetGameObject("RifleBeast0") != null);
	bool gameModeBattleRush = GameMode.GetName() == "GameModeBattleRush"
	bool isBSRActive = HMM.GetMods().Where(x => x.Name == "Boss Select Rematch").Count() > 0;
	bool RifleBattle = (GameManager.GetGameObject("Rifle0") != null))
	
	if (!RifleBattle) 
		return;
	{
		if (isRifleBeast0)
		{
			WriteProtected<byte>(Adr4110, System.Text.Encoding.UTF8.GetBytes("bo4111"));
			WriteProtected<byte>(Adr4160, System.Text.Encoding.UTF8.GetBytes("bo4162"));
			
			bool rifleStrt2 = Lua.Call<int>("IsPlayingDiEvent", "bo4111") == 1
			if (rifleStrt2)
			{
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[0], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_NONE);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[4], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT2);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[7], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT1);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[10], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_NONE);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[13], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT3);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[15], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT4);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[17], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_LASER);
				
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patternChangeHpRatios[1], 80);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patterns[1].attackDatas[10].attackType, BossRifleConfig.ActionType.AT_SHOT2);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patterns[1].attackDatas[11].attackType, BossRifleConfig.ActionType.AT_SHOT3);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patterns[1].bitBreakAttackDatas[0].attackType, BossRifleConfig.ActionType.AT_COUNTER_BLOW);
				
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patternChangeHpRatios[2], 65);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patterns[2].bitBreakAttackDatas[0].attackType, BossRifleConfig.ActionType.AT_SHOT1);
			}
			
			if (Lua.Call<int>("IsPlayingDiEvent", "bo4140") == 1)
			{ RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[1].patterns[0].bitBreakAttackDatas[0].attackType, BossRifleConfig.ActionType.AT_SHOT2); }
			
			if (Lua.Call<int>("IsPlayingDiEvent", "zev_rfl_wng1") == 1)
			{ RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[1].patterns[0].bitBreakAttackDatas[0].attackType, BossRifleConfig.ActionType.AT_QTE_NONE); }

			if ((Lua.Call<int>("IsPlayingDiEvent", "zev_rfl_shoot01") == 1) || (Lua.Call<int>("IsPlayingDiEvent", "zev_rfl_lsQTE02") == 1))
			{
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[1].patterns[0].attackDatas[2].attackType, BossRifleConfig.ActionType.AT_LASER);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[1].patterns[0].bitBreakAttackDatas[0].attackType, BossRifleConfig.ActionType.AT_HOMINGLASER_NORMAL);
			}
		}
		else
		{
			WriteProtected<byte>(Adr4110, System.Text.Encoding.UTF8.GetBytes("bo4110"));
			WriteProtected<byte>(Adr4160, System.Text.Encoding.UTF8.GetBytes("bo4160"));
				
			if (!gameModeBattleRush)
			{ RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[0], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_NONE); }
			else
			{ 
				if (!isBSRActive)
				{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 90000);  }
				else
				{ RFL_SET_PARAM(BossRifleConfigInfo, bossBaseConfig.status.healthPoint, 104000);  }
				
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[0], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT3);
			}
			
			RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[4], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_COUNTER_BLOW);
			RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[7], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SP02);
			RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[10], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_NONE);
			RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[13], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SP01);
			
			if ((Lua.Call<int>("IsPlayingDiEvent", "zev_rfl_sp02") == 1) || (Lua.Call<int>("IsPlayingDiEvent", "zev_rfl_spX2") == 1) || (Lua.Call<int>("IsPlayingDiEvent", "zev_rfl_wing") == 1))
			{ RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[1].patterns[0].bitBreakAttackDatas[0].attackType, BossRifleConfig.ActionType.AT_QTE_NONE); }
			
			bool rifleStrt1 = Lua.Call<int>("IsPlayingDiEvent", "bo4110") == 1
			bool rifleBattl = Lua.Call<int>("IsPlayingDiEvent", "zev_rfl_start00") == 1
			
			if (rifleStrt1)
			{
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[15], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT1);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[17], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT3);
				
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patternChangeHpRatios[1], 0);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patternChangeHpRatios[2], 65);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patterns[2].bitBreakAttackDatas[0].attackType, BossRifleConfig.ActionType.AT_SP01);
			}
			if (rifleBattl)
			{
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[15], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_SHOT2);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.immediateActions[17], BossRifleConfig.BossRifleBattleParam_ActionType.BossRifleBattleParam_ActionType_AT_NONE);
				
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patternChangeHpRatios[1], 0);
				RFL_SET_PARAM(BossRifleConfigInfo, battleParam.giantPhaseParams[0].patternChangeHpRatios[2], 0);
			}
		}
	}
}

Code "Supreme Dynamics" by "Hypernova" and "Gordon Ramsay"
//
	#lib "GameManager"
	#lib "Reflection"
	#lib "EventPlayer"
	#lib "GameObject"
	#lib "GameMode"
	#lib "Lua"
	#lib "Player"
	
	#import "Services"
	#import "GOComponents"
	#import "Graphics"
	#import "Plugins"
	
	#include "Reflection" noemit

	static long ATPHASE = 0;
	static long AT0RING = 0;
	static long ATSHOTB = 0;
	static long ATSHOT3 = 0;
	static long ATSHOT1 = 0;
	static string[] shot01_rng01 = new[] { /* sup */ "zev_rfl_shoot02", "zev_rfl_shootX2", "zev_rfl_spQTE02", "zev_rfl_spQTEX2" };
	static long ATSHOT2 = 0;
	static string[] shot02_rng01 = new[] { /* sup */ "zev_rfl_spX2", "zev_rfl_sp02" };
	static long AdCyAtk = 0;
	static long AdCyPry = 0;
//
{
	var evtPlayer = (EventPlayer.Data*)GameManager.GetService("EventPlayer");
	if (evtPlayer == null)
		return;
		
	var pkinematics = Player.Kinematics.Get();
	
	if (ATPHASE == 0) { /* 0x1414624C0 */ ATPHASE = ScanSignature ("bo4140", "xxxxxx"); }
	if (AT0RING == 0) { /* 0x1414624C8 */ AT0RING = ScanSignature ("bo4180", "xxxxxx"); }
	if (ATSHOTB == 0) { /* 0x141462108 */ ATSHOTB = ScanSignature ("zev_rfl_bitlaser02", "xxxxxxxxxxxxxxxxxx"); }
	if (ATSHOT3 == 0) { /* 0x141461EF0 */ ATSHOT3 = ScanSignature ("zev_rfl_laser01", "xxxxxxxxxxxxxxx"); }
	if (ATSHOT1 == 0) { /* 0x141461EE0 */ ATSHOT1 = ScanSignature ("zev_rfl_shoot02", "xxxxxxxxxxxxxxx"); }
	if (ATSHOT2 == 0) { /* 0x141461F10 */ ATSHOT2 = ScanSignature ("zev_rfl_sp02", "xxxxxxxxxxxx"); }
	if (AdCyAtk == 0) { /* 0x14140F690 */ AdCyAtk = ScanSignature ("cyloop_counter", "xxxxxxxxxxxxxx"); }
	if (AdCyPry == 0) { /* 0x14140F6A0 */ AdCyPry = ScanSignature ("cyloop_counter_parry", "xxxxxxxxxxxxxxxxxxxx"); }

	if (Lua.GetState() == 0)
		return;
	
	if (Lua.Call<int>("IsPlayingDiEvent", "ev5020") == 1)
	{ Lua.Call("SetLayerEnabled", "w1r04_plan_common", false); }
	
	bool RifleBattle = ((Player.State.GetStatePlugin("StatePluginBossBattle") != null) && (GameManager.GetGameObject("Rifle0") != null))
	if (!RifleBattle) 
		return;
	{
		bool gameModeBattleRush = GameMode.GetName() == "GameModeBattleRush"
		if (gameModeBattleRush)
		{ WriteProtected<byte>(ATSHOT3, System.Text.Encoding.UTF8.GetBytes("zev_rfl_start00")); }
		
		bool ZevRifle = ((evtPlayer != null) && (GameManager.GetGameObject("Rifle0") != null))
		if (!ZevRifle)
			return;
		{			
			WriteProtected<byte>(AdCyAtk, System.Text.Encoding.UTF8.GetBytes("cyloop_counter"));
			WriteProtected<byte>(AdCyPry, System.Text.Encoding.UTF8.GetBytes("cyloop_counter_parry"));

			if (evtPlayer != null)
			{
				if ((Lua.Call<int>("IsPlayingDiEvent", "ev5020") == 1) || (Lua.Call<int>("IsPlayingDiEvent", "ev1770") == 1))
				{ 
					pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
					pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 0.701707f, 0.0f, 0.701707f);
				}
				
				if (Lua.Call<int>("IsPlayingDiEvent", "bo4146") == 1)
				{ 		
					pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
					pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
					
					var setupData = new EventPlayer.EventSetupData("bo4141");
					evtPlayer->PlayEvent(ref setupData);
				}
				
				if (Lua.Call<int>("IsPlayingDiEvent", "bo4145") == 1)
				{ 		
					pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
					pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
					
					var setupData = new EventPlayer.EventSetupData("bo4140");
					evtPlayer->PlayEvent(ref setupData);
				}
				
				bool isLaser0b = evtPlayer->IsEventPlaying("zev_rfl_laser0b") 
				bool isSpQTE01 = evtPlayer->IsEventPlaying("zev_rfl_spQTE01") 
				bool isLaser01 = evtPlayer->IsEventPlaying("zev_rfl_laser01") 
				bool isShoot01 = evtPlayer->IsEventPlaying("zev_rfl_shoot01") 

				bool isLaser02 = evtPlayer->IsEventPlaying("zev_rfl_laser02")
				bool isZevLsXX = evtPlayer->IsEventPlaying("zev_rfl_lsXX")
				bool isZevSp02 = evtPlayer->IsEventPlaying("zev_rfl_sp02") 
				bool isZevSpX2 = evtPlayer->IsEventPlaying("zev_rfl_spX2")
				bool isZevWng0 = evtPlayer->IsEventPlaying("zev_rfl_wing") 
				bool isZevWng1 = evtPlayer->IsEventPlaying("zev_rfl_wng1") 
				bool isZevWng2 = evtPlayer->IsEventPlaying("zev_rfl_wng2") 
				
				if ((isLaser0b) || (isSpQTE01) || (isLaser01) || (isShoot01))
				{ 				
					pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
					pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
				}
				else if ((isLaser02) || (isZevLsXX) || (isZevSp02) || (isZevSpX2) || (isZevWng0) || (isZevWng1) || (isZevWng2))
				{ 
					Lua.Call("HideObjectInEvent", "BossLargeBit2", true);
					Lua.Call("HideObjectInEvent", "BossLargeBit3", true);
					
					pkinematics->Position = new System.Numerics.Vector3(-125.826f, 238.337f, -1170.940f);
					pkinematics->Rotation = new System.Numerics.Quaternion(0.0f, 1.0f, 0.0f, 0.0f);
				}
				else
				{ 
					Lua.Call("HideObjectInEvent", "BossLargeBit2", false);
					Lua.Call("HideObjectInEvent", "BossLargeBit3", false);
				}
				
				bool isRifleBeast0 = (GameManager.GetGameObject("RifleBeast0") != null);
				bool isBSRActive = HMM.GetMods().Where(x => x.Name == "Boss Select Rematch").Count() > 0;
				
				string eventName = evtPlayer->GetCurrentEventName();	
				switch (eventName)
				{
					case "bo4110":
					case "bo4111":
					case "bo4180":
					case "bo4181":
					case "zev_rfl_start00":
						WriteProtected<byte>(ATSHOT3, System.Text.Encoding.UTF8.GetBytes("zev_rfl_spQTE01")); 
						WriteProtected<byte>(ATSHOT1, System.Text.Encoding.UTF8.GetBytes("zev_rfl_laser01"));
						WriteProtected<byte>(AT0RING, System.Text.Encoding.UTF8.GetBytes("bo4180"));
						if (isRifleBeast0)
						{ 
							WriteProtected<byte>(ATPHASE, System.Text.Encoding.UTF8.GetBytes("bo4146")); 
							WriteProtected<byte>(ATSHOTB, System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaser01"));
							WriteProtected<byte>(ATSHOT2, System.Text.Encoding.UTF8.GetBytes("zev_rfl_ls02"));
						}
						else if (gameModeBattleRush)
						{ 
							WriteProtected<byte>(ATPHASE, System.Text.Encoding.UTF8.GetBytes("bo4145")); 
							WriteProtected<byte>(ATSHOTB, System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaserB1"));
							WriteProtected<byte>(ATSHOT2, System.Text.Encoding.UTF8.GetBytes("zev_rfl_ls00"));
						}
						else 
						{
							WriteProtected<byte>(ATPHASE, System.Text.Encoding.UTF8.GetBytes("bo4146")); 
							WriteProtected<byte>(ATSHOTB, System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaserA1"));
							WriteProtected<byte>(ATSHOT2, System.Text.Encoding.UTF8.GetBytes("zev_rfl_ls01"));
						}
						break;
					case "zev_rfl_bitlaser01":
					case "zev_rfl_bitlaserB1":
						WriteProtected<byte>(ATSHOTB, System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaserA1"));
						break;
					case "zev_rfl_bitlaserA1":
						WriteProtected<byte>(ATSHOTB, System.Text.Encoding.UTF8.GetBytes("zev_rfl_bitlaserB1"));
						break;
					case "zev_rfl_laser01":
						WriteProtected<byte>(ATPHASE, System.Text.Encoding.UTF8.GetBytes("bo4145"));
						WriteProtected<byte>(ATSHOT3, System.Text.Encoding.UTF8.GetBytes("zev_rfl_spQTE01"));
						WriteProtected<byte>(ATSHOT1, System.Text.Encoding.UTF8.GetBytes("zev_rfl_laser0b"));
						break;	
					case "zev_rfl_spQTE01":
						WriteProtected<byte>(ATPHASE, System.Text.Encoding.UTF8.GetBytes("bo4145")); 
						WriteProtected<byte>(ATSHOT3, System.Text.Encoding.UTF8.GetBytes("zev_rfl_laser00"));
						break;
					case "zev_rfl_laser00":
						WriteProtected<byte>(ATSHOT3, System.Text.Encoding.UTF8.GetBytes("zev_rfl_spQTE01"));
						break;
					case "zev_rfl_ls00":
						WriteProtected<byte>(ATSHOT2, System.Text.Encoding.UTF8.GetBytes("zev_rfl_ls01"));
						WriteProtected<byte>(ATSHOT1, System.Text.Encoding.UTF8.GetBytes("zev_rfl_laser01"));
						break;
					case "zev_rfl_ls02":
						WriteProtected<byte>(ATSHOT2, System.Text.Encoding.UTF8.GetBytes("zev_rfl_ls00"));
						WriteProtected<byte>(ATSHOT1, System.Text.Encoding.UTF8.GetBytes("zev_rfl_laser01"));
						break;
					case "zev_rfl_ls01":
						WriteProtected<byte>(ATSHOT2, System.Text.Encoding.UTF8.GetBytes("zev_rfl_ls00"));
						WriteProtected<byte>(ATSHOT1, System.Text.Encoding.UTF8.GetBytes("zev_rfl_laser0b"));
						break;
					case "zev_rfl_laser0b":
						WriteProtected<byte>(ATPHASE, System.Text.Encoding.UTF8.GetBytes("bo4145")); 
